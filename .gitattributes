# New source and configuration: normalized, LF in the working tree on every OS.
* text=auto eol=lf

# Byte-exact areas. Records in rd/ cite files by SHA-256, and those files mix
# CRLF and LF. An end-of-line conversion on commit or checkout would change
# their bytes and break the recorded hashes (.cursor/rules/evidence.mdc).
# docs/ holds specifications that the records cite the same way.
rd/** -text
docs/** -text
README.md -text
AGENTS.md -text
.agents/skills/solver-rd/** -text
.agents/skills/solver-design-contracts/** -text
.agents/skills/solver-implementation-review/** -text
.claude/skills/solver-rd/** -text
.claude/skills/solver-design-contracts/** -text
.claude/skills/solver-implementation-review/** -text

# Skills that come from outside (skills-lock.json) are kept as received.
.agents/skills/grilling/** -text
.agents/skills/natural-japanese/** -text
.claude/skills/grilling/** -text
.claude/skills/natural-japanese/** -text

*.png binary
*.pdf binary
*.npz binary
*.mat binary

# The imported historical PG artifacts retain the bytes cited by the R&D evidence index.
tests/numerics/fixtures/j1-pg-free-history-24-v1/source/** -text

# Preserve the imported baseline port's usage text verbatim.
cmake/vcpkg-ports/nlohmann-json/usage -text

# Preserve the exact whitespace of this frozen execution evidence.
docs/verification/IM-01/im01-partition-product/logs/** -whitespace
docs/verification/IM-01/im01-partition-product/run_resource_control.py.txt -whitespace

# New exact JSON records were produced on Windows; keep their CRLF bytes.
docs/verification/IM-03/global-geometry-te-start-v1/result.json whitespace=cr-at-eol
docs/verification/IM-03/global-geometry-te-start.json whitespace=cr-at-eol

# Preserve captured Windows CRLF in this new evidence set; inspect real trailing spaces.
docs/verification/IM-01/im01-incidence-product/logs/* whitespace=cr-at-eol
# Catch2 prints a final empty line; retain it only in the five captured test streams.
docs/verification/IM-01/im01-incidence-product/logs/*-test.log whitespace=cr-at-eol,-blank-at-eof
