root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,cmake,clang-format,clang-tidy}]
indent_size = 2

[CMakeLists.txt]
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[justfile]
indent_size = 4

# Byte-exact evidence areas (see .gitattributes). Editors must not rewrite them.
[{docs/verification/**,tools/design-experiments/**,output/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
