cmake_minimum_required(VERSION 3.25)

function(check expected_code diagnostic)
    set(capture "${CASE_DIRECTORY}/inspect.stdout")
    execute_process(COMMAND "${UVLAS_EXECUTABLE}" inspect ${ARGN}
        WORKING_DIRECTORY "${CASE_DIRECTORY}"
        RESULT_VARIABLE code OUTPUT_FILE "${capture}" ERROR_VARIABLE error
        ENCODING UTF-8 TIMEOUT 5)
    if(NOT "${code}" STREQUAL "${expected_code}")
        message(FATAL_ERROR "Exit code ${code}, expected ${expected_code}. stderr: ${error}")
    endif()
    if(expected_code EQUAL 0)
        file(SHA256 "${capture}" output_hash)
        file(SHA256 "${status_path}" status_hash)
        if(NOT output_hash STREQUAL status_hash OR NOT error STREQUAL "")
            message(FATAL_ERROR "Expected the exact verified status bytes. stderr: ${error}")
        endif()
    else()
        file(SIZE "${capture}" output_bytes)
        string(FIND "${error}" "${diagnostic}" diagnostic_position)
        if(NOT output_bytes EQUAL 0 OR diagnostic_position LESS 0)
            message(FATAL_ERROR "Expected ${diagnostic}. stdout bytes: ${output_bytes} stderr: ${error}")
        endif()
    endif()
    file(REMOVE "${capture}")
endfunction()

set(directory "結果 case")
set(result "${CASE_DIRECTORY}/${directory}")
file(MAKE_DIRECTORY "${result}")
set(status_path "${result}/status.json")
set(provenance_path "${result}/provenance.json")
set(resolved_path "${result}/resolved-case.json")
file(REMOVE "${status_path}" "${provenance_path}" "${resolved_path}")
check(2 "Expected one result directory.")
check(6 "result directory" missing)
check(6 "status.json" "${directory}")

execute_process(COMMAND "${UVLAS_EXECUTABLE}" --build-info
    OUTPUT_VARIABLE build COMMAND_ERROR_IS_FATAL ANY ENCODING UTF-8 TIMEOUT 5)
string(STRIP "${build}" build)
file(WRITE "${resolved_path}" "{\"sample\":\"resolved case bytes\"}\n")
file(SHA256 "${resolved_path}" resolved_digest)
string(SHA256 original_digest "source")
set(provenance "{\"build\":${build},\"original_case\":{\"source_id\":\"0\",\"byte_count\":\"6\",\"sha256\":\"${original_digest}\"},\"resolved_case_sha256\":\"${resolved_digest}\"}\n")
file(WRITE "${provenance_path}" "${provenance}")
file(SHA256 "${provenance_path}" provenance_digest)
set(status "{\"completed\":true,\"exit_code\":0,\"failure\":null,\"last_accepted\":null,\"provenance_sha256\":\"${provenance_digest}\"}\n")
file(WRITE "${status_path}" "${status}")
check(0 "" "${directory}")
check(0 "" "${result}")

file(APPEND "${provenance_path}" " ")
check(6 "status.json and provenance.json" "${directory}")
file(WRITE "${provenance_path}" "${provenance}")
file(APPEND "${resolved_path}" " ")
check(6 "resolved-case.json" "${directory}")
file(REMOVE "${resolved_path}")
check(6 "resolved-case.json" "${directory}")

set(provenance "{\"build\":${build},\"original_case\":null,\"resolved_case_sha256\":null}\n")
file(WRITE "${provenance_path}" "${provenance}")
file(SHA256 "${provenance_path}" provenance_digest)
set(details [=[{"model":null,"parent":null,"trial":null,"numerical_generation":null,"component":null,"problem":null,"problem_domain":null,"resources":null,"last_accepted":"18446744073709551615"}]=])
set(status "{\"completed\":false,\"exit_code\":4,\"failure\":{\"code\":\"LinearUnconverged\",\"operation\":\"SolveLinear\",\"details\":${details}},\"last_accepted\":{\"id\":\"18446744073709551615\"},\"provenance_sha256\":\"${provenance_digest}\"}\n")
file(WRITE "${status_path}" "${status}")
file(SHA256 "${status_path}" expected_hash)
check(0 "" "${directory}")
file(SHA256 "${status_path}" hash_after_inspection)
if(NOT hash_after_inspection STREQUAL expected_hash)
    message(FATAL_ERROR "Inspection modified status.json.")
endif()
string(REPLACE "\"completed\":false" "\"completed\":true" inconsistent "${status}")
file(WRITE "${status_path}" "${inconsistent}")
check(6 "status.json and provenance.json" "${directory}")
string(REPLACE "\"exit_code\":4" "\"exit_code\":0,\"exit_code\":4" duplicate "${status}")
file(WRITE "${status_path}" "${duplicate}")
check(6 "status.json and provenance.json" "${directory}")

math(EXPR oversized "1024 * 1024 + 1")
string(REPEAT " " ${oversized} large_status)
file(WRITE "${status_path}" "${large_status}")
check(5 "resource limit exceeded at status.json" "${directory}")
file(REMOVE "${status_path}" "${provenance_path}")
