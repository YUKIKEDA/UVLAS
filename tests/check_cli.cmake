cmake_minimum_required(VERSION 3.25)

if(CASE STREQUAL "version")
    set(arguments --version)
    set(expected_code 0)
elseif(CASE STREQUAL "help")
    set(arguments --help)
    set(expected_code 0)
elseif(CASE STREQUAL "missing-option")
    set(arguments)
    set(expected_code 2)
elseif(CASE STREQUAL "unknown-option")
    set(arguments --not-an-option)
    set(expected_code 2)
elseif(CASE STREQUAL "extra-option")
    set(arguments --version unexpected)
    set(expected_code 2)
else()
    message(FATAL_ERROR "Unknown test case: ${CASE}")
endif()

execute_process(COMMAND "${UVLAS_EXECUTABLE}" ${arguments}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error
    ENCODING UTF-8 TIMEOUT 5)
string(REPLACE "\r\n" "\n" output "${output}")
string(REPLACE "\r\n" "\n" error "${error}")

if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "Exit code ${code}, expected ${expected_code}. stderr: ${error}")
endif()

if(expected_code EQUAL 0)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "Unexpected stderr: ${error}")
    endif()
    if(CASE STREQUAL "version")
        string(FIND "${output}" "UVLAS ${EXPECTED_VERSION}\n" version_position)
        string(FIND "${output}" "Configuration: ${EXPECTED_CONFIGURATION}\n" config_position)
        if(NOT version_position EQUAL 0 OR config_position LESS 0)
            message(FATAL_ERROR "Incorrect build metadata: ${output}")
        endif()
        if(NOT output MATCHES "Compiler: [^\n]+\nPlatform: [^\n]+\n")
            message(FATAL_ERROR "Missing compiler or platform: ${output}")
        endif()
    elseif(NOT output MATCHES "^Usage: uvlas --help [|] --version\n")
        message(FATAL_ERROR "Missing usage: ${output}")
    endif()
else()
    if(NOT output STREQUAL "")
        message(FATAL_ERROR "Invalid input must not emit success output: ${output}")
    endif()
    if(CASE STREQUAL "unknown-option")
        set(expected_error "Unknown option: --not-an-option\n")
    else()
        set(expected_error "Expected exactly one option.\n")
    endif()
    string(FIND "${error}" "${expected_error}" error_position)
    if(NOT error_position EQUAL 0 OR NOT error MATCHES "Usage: uvlas")
        message(FATAL_ERROR "Missing input diagnostic: ${error}")
    endif()
endif()
