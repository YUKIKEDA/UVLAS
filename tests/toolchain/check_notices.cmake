# N4-01: preserve upstream texts instead of replacing them with SPDX names.
file(GLOB originals "${SHARE_DIR}/*/copyright")
list(LENGTH originals count)
if(count EQUAL 0)
    message(FATAL_ERROR "No upstream third-party notices found")
endif()
foreach(original IN LISTS originals)
    get_filename_component(package_dir "${original}" DIRECTORY)
    get_filename_component(package "${package_dir}" NAME)
    set(copy "${NOTICES_DIR}/${package}.txt")
    if(NOT EXISTS "${copy}")
        message(FATAL_ERROR "Missing copied notice: ${package}")
    endif()
    file(SIZE "${original}" size)
    if(size EQUAL 0)
        message(FATAL_ERROR "Empty upstream notice: ${package}")
    endif()
    file(SHA256 "${original}" expected)
    file(SHA256 "${copy}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Third-party notice changed: ${package}")
    endif()
endforeach()
message(STATUS "Verified ${count} verbatim third-party notices (N4-01)")
