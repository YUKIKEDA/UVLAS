# Called by the native audit target after its two linked artifacts are current.
if(NOT CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Runtime artifact provenance requires a Release build")
endif()

file(SHA256 "${REVISION_HEADER}" revision_digest)
set(artifacts "{}")
foreach(kind IN ITEMS cli extension)
    if(kind STREQUAL "cli")
        set(binary "${CLI}")
        set(receipt_path "${CLI_RECEIPT}")
    else()
        set(binary "${EXTENSION}")
        set(receipt_path "${EXTENSION_RECEIPT}")
    endif()
    file(SHA256 "${binary}" digest)
    file(READ "${receipt_path}" receipt)
    if(NOT receipt STREQUAL "${revision_digest}\n${digest}\n")
        message(FATAL_ERROR "Runtime ${kind} differs from its link receipt for this source revision; rebuild the target")
    endif()
    file(RELATIVE_PATH relative "${BUILD_DIR}" "${binary}")
    get_filename_component(name "${binary}" NAME)
    string(JSON artifact SET "{}" name "\"${name}\"")
    string(JSON artifact SET "${artifact}" relative_path "\"${relative}\"")
    string(JSON artifact SET "${artifact}" sha256 "\"${digest}\"")
    string(JSON artifacts SET "${artifacts}" "${kind}" "${artifact}")
endforeach()

execute_process(COMMAND "${CLI}" --build-info
    RESULT_VARIABLE status OUTPUT_VARIABLE info ERROR_VARIABLE errors)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Could not read built CLI provenance (${status}): ${errors}")
endif()

string(JSON configuration GET "${info}" configuration)
string(JSON dirty GET "${info}" uncommitted_changes)
string(JSON schema GET "${info}" schema)
if(NOT schema STREQUAL "uvlas.build-info/1" OR NOT configuration STREQUAL CONFIG OR dirty)
    message(FATAL_ERROR "Runtime artifact provenance requires a clean Release CLI")
endif()


string(JSON manifest SET "{}" schema "\"uvlas.runtime-artifact-producer/1\"")
string(JSON manifest SET "${manifest}" build_info "${info}")
string(JSON manifest SET "${manifest}" artifacts "${artifacts}")
string(RANDOM LENGTH 16 suffix)
set(temporary "${OUTPUT}.${suffix}.tmp")
file(WRITE "${temporary}" "${manifest}\n")
file(RENAME "${temporary}" "${OUTPUT}" RESULT renamed)
if(NOT renamed STREQUAL "0")
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Could not publish runtime artifact provenance: ${renamed}")
endif()
