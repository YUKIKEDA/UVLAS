# Compile all audited product translation units with the same Eigen policy.
function(uvlas_enable_allocation_audit target)
    target_compile_definitions(${target} PRIVATE EIGEN_RUNTIME_NO_MALLOC)
    if(MSVC)
        target_compile_options(${target} PRIVATE /UNDEBUG)
    else()
        target_compile_options(${target} PRIVATE -UNDEBUG)
    endif()
    set_property(TARGET ${target} PROPERTY UVLAS_ALLOCATION_AUDITED TRUE)
endfunction()

# A normal product library must not contribute Eigen inline definitions with another policy.
function(_uvlas_check_audited_target target visited)
    if("${target}" IN_LIST visited)
        return()
    endif()
    list(APPEND visited "${target}")
    get_target_property(imported ${target} IMPORTED)
    get_target_property(kind ${target} TYPE)
    if(imported)
        if(target STREQUAL "Catch2::Catch2" OR
           target STREQUAL "Catch2::Catch2WithMain")
            return()
        endif()
        if(NOT kind STREQUAL "INTERFACE_LIBRARY")
            message(FATAL_ERROR "Allocation audit cannot accept opaque compiled artifact ${target}")
        endif()
    endif()
    get_target_property(audited ${target} UVLAS_ALLOCATION_AUDITED)
    if(NOT kind STREQUAL "INTERFACE_LIBRARY" AND NOT audited)
        message(FATAL_ERROR "Allocation audit cannot link unaudited product target ${target}")
    endif()
    get_target_property(object_sources ${target} SOURCES)
    get_target_property(interface_sources ${target} INTERFACE_SOURCES)
    list(APPEND object_sources ${interface_sources})
    foreach(source IN LISTS object_sources)
        if(source MATCHES "-NOTFOUND$")
            continue()
        endif()
        if(source MATCHES "^\\$<TARGET_OBJECTS:([^<>]+)>$")
            set(object_target "${CMAKE_MATCH_1}")
            if(NOT TARGET ${object_target})
                message(FATAL_ERROR "Unknown allocation audit object target ${object_target}")
            endif()
            _uvlas_check_audited_target(${object_target} "${visited}")
        elseif(source MATCHES "\\$<")
            message(FATAL_ERROR "Allocation audit requires explicit source dependencies: ${source}")
        else()
            string(TOLOWER "${source}" lower_source)
            get_source_file_property(external_object "${source}" TARGET_DIRECTORY ${target} EXTERNAL_OBJECT)
            if(external_object OR lower_source MATCHES "\\.(obj|o|lib|a|dll|dylib|so([.][0-9]+)*)$")
                message(FATAL_ERROR "Allocation audit cannot accept opaque compiled artifact ${source}")
            endif()
        endif()
    endforeach()
    get_target_property(dependencies ${target} LINK_LIBRARIES)
    get_target_property(interface_dependencies ${target} INTERFACE_LINK_LIBRARIES)
    list(APPEND dependencies ${interface_dependencies})
    foreach(dependency IN LISTS dependencies)
        if(dependency MATCHES "-NOTFOUND$")
            continue()
        endif()
        if(dependency MATCHES "^\\$<LINK_ONLY:([^<>]+)>$")
            set(dependency "${CMAKE_MATCH_1}")
        endif()
        if(dependency MATCHES "^\\$<TARGET_OBJECTS:([^<>]+)>$")
            set(dependency "${CMAKE_MATCH_1}")
        endif()
        if(dependency MATCHES "\\$<")
            message(FATAL_ERROR "Allocation audit requires explicit target dependencies: ${dependency}")
        endif()
        if(NOT TARGET ${dependency})
            if(dependency STREQUAL "psapi")
                continue()
            endif()
            message(FATAL_ERROR "Allocation audit cannot accept opaque compiled artifact ${dependency}")
        endif()
        _uvlas_check_audited_target(${dependency} "${visited}")
    endforeach()
endfunction()

function(uvlas_require_audited_dependencies target)
    _uvlas_check_audited_target(${target} "")
endfunction()
