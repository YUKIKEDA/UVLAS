  "claimed_state": "Vector circulatory and noncirculatory loads on the same contact-qualified discrete circulation trial, exact canonical midpoint self masking, nodal distribution and moment about a supplied reference.",
  "verification": {
    "msvc": "Windows 11 x64, MSVC 19.51. Debug and Release passed 6/6 on dbee15a4b8a8db3b91130a0ba34a82432223de68, with final Debug coupling rerun on b47c6b53 after a test-only lint correction.",
    "gcc": "Ubuntu Noble chroot, GCC 14.2 Release, warnings as errors. 6/6 on the implementation and final affected coupling rerun passed.",
    "ctest": [
      "coupling.case_uniform_flow",
      "aero.p1_shared_action",
      "aero.global_geometry",
      "aero.local_geometry_packet",
      "aero.p1_induction",
      "numerics.dense_solve"
    ],
    "catch": "Selected discrete nonpenetration and circulation cases 4 cases, 2039 assertions. Loads fixture 1 case, 1101 assertions, seed 23.",
    "oracle": "60 digit direct regularized filaments and GL48/72/96 wake area integrals with independent midpoint, triangles, force and moment evaluation. Both TE signs. Two adjacent bounds verify shared edge and exact reverse alias. GL72→96 maximum changes 9.00e-36 N per edge and 1.86e-36 N m net moment. Conservation of the geometry-node distribution and preserved Γdot low word.",
    "mutations": [
      "Mask the entire bound ring at each midpoint: 38 affected assertions fail.",
      "Treat a trailing edge as a force edge: correct load input rejects, one assertion fails.",
      "Distribute 1/3 rather than 1/2 of each edge force to a vertex: 30 assertions fail."
    ],
    "mutation_environment": "Isolated GCC 14.2 Release copies of dbee15a4. All mutants exit Catch2 with code 42.",
    "static": "clang-format 21.1.2 and Windows and Linux clang-tidy 21.1.1 for all five changed translation units. Test-only fixes explicitly qualify enum and count types.",
    "scope": "Value loads on explicit, contact-qualified real discrete bound quadrilaterals with positive regularization and supplied SI Γdot, midpoint velocities, density and moment origin. History evolution, PG material mapping and structural work/power or differential loads are downstream."
  },
