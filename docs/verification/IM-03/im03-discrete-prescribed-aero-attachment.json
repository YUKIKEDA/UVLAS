  "claimed_state": "Typed prescribed attachment produces a contact-qualified rounded geometry snapshot and fixed material collocations with the same exact-time rigid pose's position and velocity; Binary64 and TwoWord checked.",
  "verification": {
    "msvc": "Windows x64 MSVC 19.51 Debug and Release, affected CTest 7/7 per configuration. Coupling suite 49.61 s in Debug (90 s limit) and 5.94 s in Release.",
    "gcc": "Ubuntu Noble x64 GCC 14.2 Release, warnings as errors, affected CTest 7/7. Coupling suite 5.16 s.",
    "ctest": [
      "coupling.case_uniform_flow",
      "coupling.case_motion",
      "coupling.case_motion_frame",
      "coupling.case_motion_time_series",
      "aero.geometry_snapshot",
      "aero.global_geometry",
      "aero.p1_shared_action"
    ],
    "catch": "Two focused cases, 239 assertions per configuration, seed 23. The new prescribed attachment case has 67 assertions.",
    "oracle": "Direct sin(60 degrees), cos(60 degrees), rigid angular velocity and normal projection give the independent position, velocity and -5*pi/3 normal residual. Equivalent exact-vertex and explicit-tangent paths match value, a nonzero tangent solve, and the transpose pairing.",
    "negative": "Rejected a different exact time with identical display double, mismatched known-flow side, altered live motion at the same stamp, alias given as a canonical point, and an unrelated moving point. Zero work cap performs no allocation.",
    "mutation": "A separate Linux tree used previous current coordinates in place of reference coordinates. The independent point position moved 4 m, yielding 1 failed assertion and exit 42. Restoring identical bytes passed 67 assertions.",
    "static": "Pinned clang-format 21.1.2 and Windows and Linux clang-tidy 21.1.1 on the modified motion/attachment/discrete nonpenetration and regression units."
  },
