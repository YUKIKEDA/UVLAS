    "ctest": [
      "coupling.case_uniform_flow",
      "aero.p1_shared_action",
      "aero.global_geometry",
      "numerics.dense_solve"
    ],
    "catch": "Each of the three final configurations passed the discrete nonpenetration and circulation filter (293 assertions in 3 cases, seed 23).",
    "oracle": "60-digit determinant comparisons for a nonsymmetric 2-by-2 bound panel matrix and scalar derivative for both orientations of an attached wake; direct regularized line integrals and GL96 wake surface integrals.",
    "mutations": [
      "Isolated GCC 14.2 Release without coefficient transposition: two independent transpose values and the duality check failed, Catch2 exit 42.",
      "Isolated GCC 14.2 Release replacing the checked native residual by zero: the strict original-residual negative control failed, Catch2 exit 42."
    ],
    "static": "clang-format 21.1.2 and both OS clang-tidy 21.1.1 for the affected translation units.",
    "scope": "Fixed real dense finite-discrete A_eff. The tangent consumes a supplied residual direction, and the transpose uses a dimensionless scalar dual pairing. PG material coordinates, geometry/time derivatives, wake evolution and physical wake quadrature qualification are outside the measured case."
  },
