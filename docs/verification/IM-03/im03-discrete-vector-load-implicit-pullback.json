  "claimed_state": "Fixed-contact real load pullback through one retained primal circulation and its original-residual-qualified discrete transpose, with independent supplied circulation rate.",
  "verification": {
    "msvc": "Windows 11 x64, MSVC 19.51 Debug and Release. Selected CTest 3/3 in each configuration.",
    "gcc": "Ubuntu Noble chroot, GCC 14.2 Release, warnings as errors. Selected CTest 3/3.",
    "ctest": [
      "coupling.case_uniform_flow",
      "aero.p1_shared_action",
      "numerics.dense_solve"
    ],
    "catch": "Discrete circulation loads keep midpoint and triangle force and moment; 1 case, 5274 assertions, Release on both platforms, seed 23.",
    "oracle": "65-digit Decimal direct line and wake-area integrals, then re-solve both perturbed primal circulations. Work -0.0552599357049885265356 for the single bound and attached wake and -0.0753320247028545422098 for adjacent aliased bounds. GL72/96 and central steps 1e-15/1e-18 differ by 8.24e-34 and 1.01e-32 respectively.",
    "negative": "Early matrix, scale, layout, RHS and retained-generation collisions and cancellation. Late strict RHS projection and original-residual failures protect the flow and earlier results and allow a successful retry.",
    "mutation": "Isolated GCC 14.2 Release copy drops the implicit contribution to the uniform-flow covector. Both forward and independent checks in both configurations detect it, four failures, Catch2 exit 42.",
    "static": "clang-format 21.1.2, clang-tidy 21.1.1 on implementation and regression TUs in the MSVC and GCC compile databases."
  },
