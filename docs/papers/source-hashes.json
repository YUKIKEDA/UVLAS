    },
    {
      "id": "P2",
      "claim": "Paired vector has zero linear transverse shear and normal strain through thickness",
      "basis": "Equations 12-14 proof; director algebra independently checked",
      "status": "conditional identity; not finite Green-strain cancellation"
    },
    {
      "id": "P3",
      "claim": "Full trace completion has the stated homogeneous kernel",
      "basis": "Equations 17-18 elementary right-inverse proof",
      "status": "conditional identity; not novel general theorem"
    },
    {
      "id": "P4",
      "claim": "Fixed Cartesian space has constant reference mass and rigid-motion closure",
      "basis": "Equations 21-24 proof and mechanics records",
      "status": "conditional identity; established concepts"
    },
    {
      "id": "N1",
